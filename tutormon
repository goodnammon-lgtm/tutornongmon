    <script>
        // ข้อมูลคอร์สเรียนเริ่มต้นในระบบ (Mock Database)
        let courses = [
            { id: "c1", title: "คณิตศาสตร์ ม.ปลาย: พิชิตอัตราส่วนและความแปรผัน", price: 1290, category: "คณิตศาสตร์", level: "พื้นฐาน", lessonsCount: 8, desc: "ปูพื้นฐานเรื่องอัตราส่วนและแปรผันอย่างละเอียด เข้าใจง่าย พร้อมโจทย์แนวประยุกต์ทำข้อสอบได้ทันที", videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ", image: "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?auto=format&fit=crop&w=600&q=80" },
            { id: "c2", title: "ฟิสิกส์พื้นฐาน: พลังงานความร้อนและสมบัติของสสาร", price: 1590, category: "ฟิสิกส์", level: "กลาง", lessonsCount: 10, desc: "เจาะลึกบทพลังงานความร้อน จุดเดือด อุณหภูมิ และพฤติกรรมทางกายภาพของสสาร เข้าใจสูตรคำนวณแบบไม่ต้องท่องจำ", videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ", image: "https://images.unsplash.com/photo-1507668077129-56e32842fceb?auto=format&fit=crop&w=600&q=80" },
            { id: "c3", title: "ปูพื้นฐานการเขียนโปรแกรมด้วยภาษา C สำหรับผู้เริ่มต้น", price: 990, category: "โปรแกรมมิ่ง", level: "พื้นฐาน", lessonsCount: 12, desc: "เริ่มจากศูนย์จนเข้าใจประเภทข้อมูล Int, Float, Char โครงสร้างเงื่อนไข Loop และการทำงานคอมไพเลอร์อย่างถ่องแท้", videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ", image: "https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=600&q=80" }
        ];

        // ฐานข้อมูลบันทึกรายการคำสั่งซื้อและการสมัครเรียน
