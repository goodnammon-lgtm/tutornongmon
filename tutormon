<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>tutornongmon | แพลตฟอร์มคอร์สเรียนออนไลน์แนวใหม่</title>
    <!-- ใช้ Tailwind CSS สำหรับดีไซน์หรูหรา มินิมอล โทนฟ้า-ขาว-ม่วง และ Responsive อัตโนมัติ -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome สำหรับดึงไอคอนสวยๆ มาใช้ -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap');
        body { font-family: 'Kanit', sans-serif; }
        .page-view { display: none; }
        .page-view.active { display: block; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">

    <!-- ─── 1. ส่วนหัวเว็บไซต์ & เมนูนำทาง (NAVBAR) ─── -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <!-- โลโก้แบรนด์ Tutornongmon -->
            <a href="#" onclick="navigateTo('home')" class="text-2xl font-bold text-sky-600 flex items-center gap-2 hover:scale-105 transition-transform">
                <i class="fa-solid fa-graduation-cap text-indigo-500"></i> tutornongmon
            </a>
            
            <!-- ปุ่มเมนูสำหรับคอมพิวเตอร์ -->
            <nav class="hidden md:flex items-center gap-6">
                <button onclick="navigateTo('home')" class="hover:text-sky-600 font-medium transition">หน้าแรก</button>
                <button onclick="navigateTo('courses')" class="hover:text-sky-600 font-medium transition">คอร์สทั้งหมด</button>
                <button id="menu-dashboard" onclick="navigateTo('dashboard')" class="hidden hover:text-sky-600 font-medium transition">คอร์สของฉัน</button>
                <button id="menu-admin" onclick="navigateTo('admin')" class="hidden text-amber-600 font-medium hover:text-amber-700 transition"><i class="fa-solid fa-user-shield"></i> ระบบหลังบ้าน</button>
            </nav>

            <!-- โซนสมาชิก (ปุ่มเข้าสู่ระบบ / แสดงชื่อผู้ใช้) -->
            <div id="auth-zone" class="flex items-center gap-3">
                <button onclick="navigateTo('login')" class="px-4 py-2 text-sky-600 font-medium hover:bg-sky-50 rounded-lg transition">เข้าสู่ระบบ</button>
                <button onclick="navigateTo('login')" class="px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 shadow-md transition">สมัครเรียน</button>
            </div>
        </div>
    </header>

    <!-- ─── 2. หน้าแรกของเว็บไซต์ (HOME PAGE) ─── -->
    <main id="page-home" class="page-view active flex-grow">
        <!-- แบนเนอร์ต้อนรับสุดทันสมัย (Hero Banner) -->
        <section class="bg-gradient-to-r from-sky-600 via-indigo-600 to-purple-600 text-white py-20 px-4">
            <div class="container mx-auto max-w-4xl text-center">
                <h1 class="text-4xl md:text-6xl font-bold mb-6 animate-bounce-short">เรียนง่าย เข้าใจไว กับ tutornongmon</h1>
                <p class="text-lg md:text-xl text-sky-100 mb-8 max-w-2xl mx-auto">เจาะลึกเนื้อหาเน้น ๆ รูปแบบวิดีโอออนไลน์คุณภาพสูง ทบทวนซ้ำได้ตลอดชีพ ไม่มีวันหมดอายุ</p>
                <button onclick="navigateTo('courses')" class="px-8 py-4 bg-white text-indigo-700 font-bold text-lg rounded-xl shadow-lg hover:bg-sky-50 hover:scale-105 transition-all">
                    ดูคอร์สเรียนทั้งหมด <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>
            </div>
        </section>

        <!-- โซนแสดงคอร์สแนะนำพรีเมียม -->
        <section class="container mx-auto px-4 py-16">
            <h2 class="text-3xl font-bold text-center mb-12 text-slate-800">🎯 คอร์สยอดนิยมแนะนำ</h2>
            <div id="featured-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- ข้อมูลการ์ดคอร์สจะถูกใส่ผ่าน JavaScript ด้านล่าง -->
            </div>
        </section>
    </main>

    <!-- ─── 3. หน้าแสดงคอร์สทั้งหมด & ค้นหา (COURSES PAGE) ─── -->
    <main id="page-courses" class="page-view flex-grow container mx-auto px-4 py-10">
        <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-slate-800"><i class="fa-solid fa-book-open text-sky-600"></i> คอร์สเรียนทั้งหมด</h2>
        
        <!-- ระบบค้นหาและตัวกรองข้อมูล (Search & Filters) -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-8 flex flex-col md:flex-row gap-4">
            <div class="flex-grow relative">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-400"></i>
                <input type="text" id="search-bar" placeholder="ค้นหาชื่อคอร์ส..." class="w-full pl-11 pr-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500">
            </div>
            <div class="flex gap-4">
                <select id="filter-cat" class="px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-sm">
                    <option value="all">ทุกหมวดหมู่</option>
                    <option value="คณิตศาสตร์">คณิตศาสตร์</option>
                    <option value="ฟิสิกส์">ฟิสิกส์</option>
                    <option value="โปรแกรมมิ่ง">โปรแกรมมิ่ง</option>
                </select>
                <select id="sort-price" class="px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-sm">
                    <option value="normal">เรียงลำดับ</option>
                    <option value="low">ราคา: ต่ำ - สูง</option>
                    <option value="high">ราคา: สูง - ต่ำ</option>
                </select>
            </div>
        </div>

        <!-- รายการคอร์สทั้งหมด -->
        <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8"></div>
    </main>

    <!-- ─── 4. หน้ารายละเอียดคอร์สและการส่งสลิปชำระเงิน (DETAIL & PAYMENT) ─── -->
    <main id="page-detail" class="page-view flex-grow container mx-auto px-4 py-10">
        <div id="detail-content" class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden">
            <!-- ดึงเนื้อหามาใส่ด้วย JS -->
        </div>
    </main>

    <!-- ─── 5. หน้าล็อกอินและสมัครสมาชิก (LOGIN & SIGNUP) ─── -->
    <main id="page-login" class="page-view flex-grow flex items-center justify-center px-4 py-12">
        <div class="bg-white p-8 rounded-2xl shadow-xl border border-slate-100 w-full max-w-md">
            <h2 id="auth-title" class="text-2xl font-bold text-center text-slate-800 mb-6">เข้าสู่ระบบสมาชิก</h2>
            <form id="auth-form" class="space-y-4" onsubmit="handleAuth(event)">
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">อีเมลผู้ใช้งาน</label>
                    <input type="email" id="auth-email" required class="w-full p-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">รหัสผ่าน</label>
                    <input type="password" id="auth-password" required class="w-full p-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                </div>
                <button type="submit" class="w-full py-3 bg-sky-600 text-white font-bold rounded-lg hover:bg-sky-700 transition shadow-md">ดำเนินการต่อ</button>
            </form>
            <div class="text-center mt-6">
                <button onclick="toggleAuthMode()" id="auth-toggle-btn" class="text-sm text-sky-600 font-medium hover:underline">ยังไม่มีบัญชี? สมัครสมาชิกที่นี่</button>
            </div>
            <!-- [ลบกล่องคำแนะนำสีเหลืองออกเรียบร้อยแล้วเพื่อความสวยงามเป็นทางการ] -->
        </div>
    </main>

    <!-- ─── 6. แดชบอร์ดของนักเรียน (STUDENT DASHBOARD) ─── -->
    <main id="page-dashboard" class="page-view flex-grow container mx-auto px-4 py-10">
        <h2 class="text-3xl font-bold mb-2">👋 คอร์สเรียนของฉัน</h2>
        <p class="text-slate-500 mb-8">รายชื่อคอร์สที่คุณซื้อแล้วและได้รับการอนุมัติจากแอดมิน</p>
        <div id="my-courses-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8"></div>
    </main>

    <!-- ─── 7. หน้าห้องเรียนสำหรับเล่นวิดีโอ (VIDEO PLAYER & PROTECTION) ─── -->
    <main id="page-watch" class="page-view flex-grow bg-slate-900 text-white">
        <div class="flex flex-col lg:flex-row h-[calc(100vh-73px)]">
            <!-- ฝั่งซ้าย: ตัวเล่นวิดีโอเซฟตี้ (ซ่อน URL จริง) -->
            <div class="flex-grow p-4 flex flex-col justify-center bg-black relative">
                <div id="video-wrapper" class="w-full aspect-video max-w-4xl mx-auto rounded-lg overflow-hidden shadow-2xl bg-slate-950">
                    <!-- จะถูกเรนเดอร์ป้องกันการดาวน์โหลดผ่าน JS -->
                </div>
                <div class="max-w-4xl mx-auto w-full mt-4 px-2">
                    <h3 id="watch-title-course" class="text-xl font-bold text-sky-400">ชื่อคอร์สเรียน</h3>
                    <p id="watch-title-lesson" class="text-slate-300 mt-1">บทเรียนปัจจุบัน</p>
                </div>
            </div>
            <!-- ฝั่งขวา: รายการบทเรียนด้านข้าง (Sidebar) -->
            <div class="w-full lg:w-80 bg-slate-800 border-t lg:border-t-0 lg:border-l border-slate-700 overflow-y-auto">
                <div class="p-4 border-b border-slate-700">
                    <h4 class="font-bold text-slate-200"><i class="fa-solid fa-list-ol mr-2 text-sky-400"></i> รายการบทเรียนภายในคอร์ส</h4>
                </div>
                <div id="lessons-sidebar-list" class="divide-y divide-slate-700"></div>
            </div>
        </div>
    </main>

    <!-- ─── 8. ระบบหลังบ้านแอดมิน (ADMIN PANEL) ─── -->
    <main id="page-admin" class="page-view flex-grow container mx-auto px-4 py-10">
        <h2 class="text-3xl font-bold mb-8 text-amber-600 border-b pb-4"><i class="fa-solid fa-user-shield"></i> แผงควบคุมผู้จัดการระบบ (Admin Panel)</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- ฟอร์มเพิ่ม/แก้ไขคอร์ส -->
            <div class="bg-white p-6 rounded-xl shadow-md border border-slate-200 h-fit">
                <h3 class="text-xl font-bold mb-4 text-slate-700"><i class="fa-solid fa-plus-circle text-sky-500"></i> เพิ่มคอร์สใหม่ลงเว็บ</h3>
                <form id="admin-form" class="space-y-4" onsubmit="saveCourse(event)">
                    <input type="hidden" id="edit-id">
                    <div>
                        <label class="text-sm font-medium text-slate-600">ชื่อคอร์สเรียน</label>
                        <input type="text" id="form-title" required class="w-full p-2 border rounded mt-1">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-sm font-medium text-slate-600">ราคา (บาท)</label>
                            <input type="number" id="form-price" required class="w-full p-2 border rounded mt-1">
                        </div>
                        <div>
                            <label class="text-sm font-medium text-slate-600">หมวดหมู่</label>
                            <select id="form-cat" class="w-full p-2 border rounded mt-1">
                                <option value="คณิตศาสตร์">คณิตศาสตร์</option>
                                <option value="ฟิสิกส์">ฟิสิกส์</option>
                                <option value="โปรแกรมมิ่ง">โปรแกรมมิ่ง</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-sm font-medium text-slate-600">จำนวนบทเรียน</label>
                            <input type="number" id="form-count" required class="w-full p-2 border rounded mt-1" value="5">
                        </div>
                        <div>
                            <label class="text-sm font-medium text-slate-600">ระดับความยาก</label>
                            <select id="form-level" class="w-full p-2 border rounded mt-1">
                                <option value="พื้นฐาน">พื้นฐาน</option>
                                <option value="กลาง">กลาง</option>
                                <option value="สูง">สูง</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-slate-600">คำอธิบายคอร์สสั้น ๆ</label>
                        <textarea id="form-desc" required class="w-full p-2 border rounded mt-1 h-20"></textarea>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-slate-600">ลิงก์วิดีโอเรียน (YouTube / Drive / Vimeo)</label>
                        <input type="text" id="form-video" placeholder="https://..." required class="w-full p-2 border rounded mt-1">
                    </div>
                    <button type="submit" class="w-full py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-bold rounded shadow transition">บันทึกข้อมูลคอร์ส</button>
                </form>
            </div>

            <!-- รายการอนุมัติสลิปและคอร์สเรียนทั้งหมดที่มีอยู่ -->
            <div class="lg:col-span-2 space-y-8">
                <!-- ตารางตรวจเช็คสลิปเงิน -->
                <div class="bg-white p-6 rounded-xl shadow-md border border-slate-200">
                    <h3 class="text-xl font-bold mb-4 text-emerald-600"><i class="fa-solid fa-receipt"></i> รายการสลิปที่รอการอนุมัติเข้าเรียน</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-sm">
                                    <th class="p-3">ผู้สมัคร</th>
                                    <th class="p-3">คอร์ส</th>
                                    <th class="p-3">ข้อความสลิป</th>
                                    <th class="p-3">การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody id="admin-orders-list" class="divide-y divide-slate-100 text-sm"></tbody>
                        </table>
                    </div>
                </div>
                <!-- รายชื่อคอร์สทั้งหมดเพื่อกด แก้ไข หรือ ลบ -->
                <div class="bg-white p-6 rounded-xl shadow-md border border-slate-200">
                    <h3 class="text-xl font-bold mb-4 text-slate-700"><i class="fa-solid fa-layer-group"></i> รายการคอร์สที่วางขายอยู่</h3>
                    <div id="admin-courses-manage" class="space-y-2"></div>
                </div>
            </div>
        </div>
    </main>

    <!-- ─── 9. ส่วนท้ายของเว็บไซต์ (FOOTER) ─── -->
    <footer class="bg-slate-900 text-slate-400 py-10 mt-12 border-t-4 border-sky-600">
        <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <h4 class="text-white text-lg font-bold mb-3">tutornongmon</h4>
                <p class="text-sm leading-relaxed">แพลตฟอร์มคอร์สวิดีโอเรียนออนไลน์ยุคใหม่ เรียนง่าย เข้าใจเร็ว ออกแบบเพื่อการใช้งานที่ลื่นไหลบนทุกอุปกรณ์</p>
            </div>
            <div>
                <h4 class="text-white text-lg font-bold mb-3">ช่องทางการติดต่อ</h4>
                <div class="flex gap-4 text-xl">
                    <a href="#" class="hover:text-blue-500"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#" class="hover:text-pink-500"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="hover:text-green-500"><i class="fa-brands fa-line"></i></a>
                </div>
            </div>
            <div>
                <h4 class="text-white text-lg font-bold mb-3">ช่วยเหลือและบริการ</h4>
                <p class="text-sm">หากพบปัญหาในการแจ้งแนบหลักฐานสลิป หรือล็อกอินไม่ได้ สามารถส่งข้อความติดต่อฝ่ายดูแลระบบได้ตลอดเวลา</p>
            </div>
        </div>
        <div class="text-center text-xs mt-8 pt-4 border-t border-slate-800">
            &copy; 2026 tutornongmon. All Rights Reserved.
        </div>
    </footer>

